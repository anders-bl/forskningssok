# ═══════════════════════════════════════════════════════════════
#  HUS-STANDARD .envrc — Bruk denne som mal i alle Python-repoer
# ═══════════════════════════════════════════════════════════════
#
#  Bruk:
#    1. Kopier denne fila til <repo>/.envrc
#    2. Kjør: direnv allow
#    3. Venv aktiveres automatisk når du cd'er inn i repoet
#
# ═══════════════════════════════════════════════════════════════

# Aktiver venv (alltid i repo-rot)
if [ -d "venv" ]; then
  PATH_add venv/bin
elif [ -d "backend/venv" ]; then
  # For repoer med backend i undermappe (lauvasdata, bruktmarked, etc.)
  PATH_add backend/venv/bin
fi

# Last .env hvis det finnes (for miljøvariabler)
dotenv_if_exists .env

# Last .env.<repo>-spesifikk hvis det finnes (f.eks. .env.test, .env.local)
dotenv_if_exists .env.local

# Eksporter PYTHONPATH for å unngå import-problemer
if [ -d "backend" ]; then
  export PYTHONPATH="$PWD/backend:$PYTHONPATH"
fi

# Vis hvilken Python som brukes (for debugging)
# echo "🐍 Python: $(which python3) ($(python3 --version))"
